# Copy this file to .env.local and fill in real values.

# Base URL of the FastAPI backend (VENUAI/rag_server.py).
# Read server-side by the Next.js API proxy routes in src/app/api/**.
RAG_SERVER_URL=http://127.0.0.1:8000

# Show the demo-credentials box on the login page (dev only; default hidden).
# NEXT_PUBLIC_SHOW_DEMO=true

# Shared secret that lets the backend trust X-Forwarded-For from this proxy.
# Must equal TRUSTED_PROXY_SECRET in VENUAI/.env. TRUSTED_PROXY_HOPS = number of
# trusted reverse proxies in front of Next (default 1).
# TRUSTED_PROXY_SECRET=
# TRUSTED_PROXY_HOPS=1
