# Copy this file to .env and fill in real values. Never commit the real .env.

# Groq LLM API key — https://console.groq.com
GROQ_API_KEY=<GROQ_API_KEY>

# A real Groq-served model id (see Documents/architecture-decisions.md ADR-001)
GROQ_MODEL=openai/gpt-oss-120b

# Per-request timeout for every Groq call, seconds (default 30). The AIGateway owns retries.
GROQ_TIMEOUT_SECONDS=30

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start without this set to a real value.
JWT_SECRET_KEY=<GENERATE_WITH_SECRETS_TOKEN_URLSAFE>

# JWT secret rules (S1): >= 32 bytes, not a placeholder; the server refuses to boot otherwise.
# Access tokens carry iss/aud/jti/tv; per-purpose keys are derived from it (HMAC).
# APP_ENV=production disables demo seeding and requires BCRYPT_ROUNDS >= 12.
# APP_ENV=dev
# BCRYPT_ROUNDS=12
# REFRESH_REUSE_GRACE_SECONDS=5
# First admin (no admin is ever seeded): either run `python -m VENUAI.auth create-admin --email you@corp.com`
# or set these ONCE, start the server, then remove them:
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Per-IP rate limits/lockout audit: set the SAME random value here and in chat-app/.env.local.
# The backend believes X-Forwarded-For only from a caller presenting this secret.
# TRUSTED_PROXY_SECRET=
# OAuth redirect allow-list: FRONTEND_URL + ALLOWED_ORIGINS (+ this) origins, path /api/auth/oauth/<provider>/callback
# OAUTH_ALLOWED_ORIGINS=

# Optional token lifetimes (seconds) — defaults shown
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Phase 5 — all optional; each feature below is a real implementation
# that stays inactive (and fails loud, never silently fakes success) until
# its real credentials are set. See the referenced doc for exactly what
# each gates. ──────────────────────────────────────────────────────────────

# Structured JSON logging (VENUAI/observability.py) — "text" (default) or "json"
LOG_FORMAT=text
LOG_LEVEL=INFO

# Knowledge graph backend (Documents/AI/knowledge-graph.md) — "sqlite" (default, zero-config) or "postgres"
KNOWLEDGE_GRAPH_BACKEND=sqlite
# Only read when KNOWLEDGE_GRAPH_BACKEND=postgres. Either DATABASE_URL, or the PG* vars below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venuai_graph
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=<SET_A_REAL_PASSWORD>
# PGDATABASE=venuai_graph

# OAuth sign-in (Documents/Backend/oauth.md) — unset = that provider's
# /auth/oauth/{provider}/login returns 503, not a fake success.
# GOOGLE_CLIENT_ID=<FROM_GOOGLE_CLOUD_CONSOLE>
# GOOGLE_CLIENT_SECRET=<FROM_GOOGLE_CLOUD_CONSOLE>
# GITHUB_CLIENT_ID=<FROM_GITHUB_DEVELOPER_SETTINGS>
# GITHUB_CLIENT_SECRET=<FROM_GITHUB_DEVELOPER_SETTINGS>

# Password-reset email delivery (Documents/Backend/password-reset.md) —
# unset = /auth/forgot-password returns 503 for a real account, not a fake "sent."
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<YOUR_SMTP_USERNAME>
# SMTP_PASSWORD=<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# FRONTEND_URL=http://localhost:3000

# MCP server HTTP transport (Documents/AI/mcp-deployment.md) — required
# only when running mcp_server.py with MCP_TRANSPORT=http; the stdio
# transport (the default) needs none of this.
# MCP_TRANSPORT=stdio
# MCP_API_KEY=<GENERATE_WITH_SECRETS_TOKEN_URLSAFE>
# MCP_PORT=8765

# ── Retrieval quality (Documents/AI/retrieval.md) — all optional ───────────
# RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_CANDIDATES=4
# RETRIEVAL_MIN_SCORE=0.02
# RETRIEVAL_MIN_SIMILARITY=0.2
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_ALTERNATIVES=1
# CONTEXTUAL_CHUNKING=true
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # changing it requires re-indexing

# ── Trust & safety (A3) ───────────────────────────────────────────────────────
# DEV ONLY: seeds ONE demo user (demo@chat.com / demo12345) into an empty DB. No admin is seeded.
# Always ignored when APP_ENV/ENV=production. Pair with NEXT_PUBLIC_SHOW_DEMO=true in chat-app to show the login hint.
SEED_DEMO_USER=true
# Groq prompt-injection classifier on user input + ingested chunks (falls back to regex if unavailable)
PROMPT_GUARD_ENABLED=true
# gpt-oss-safeguard policy classifier on answers (fail-open => safety_check="unavailable", never faked)
SAFEGUARD_ENABLED=true
# INGEST_GUARD_MAX_CHUNKS=200

# --- B3 --- observability, tools, MCP/A2A (all default off / inert) ---
# TRACE_STORE_CONTENT=off            # on => store PII-redacted question text in traces
# TRACE_TTL_DAYS=14
# ONLINE_EVAL_SAMPLE=0.0             # 0-1 fraction of finished traces scored locally (no LLM)
# ONLINE_EVAL_MIN_SCORE=0.5
# OTEL_EXPORTER_OTLP_ENDPOINT=       # set (+ pip install -r VENUAI/requirements-otel.txt) to export GenAI spans
# SENTRY_DSN=
# TOOL_APPROVAL=                     # unset: MCP tools need approval; on: also flagged built-ins (code_execution); off: none
# TOOL_ENFORCE_TIMEOUT=on
# MCP_TENANT_ID=default              # tenant for the static MCP_API_KEY principal
# MCP_UPLOAD_DIR=                    # allowlisted dir for the MCP upload_document tool (default VENUAI/data/mcp_uploads)
# MCP_BACKEND_URL=http://127.0.0.1:8000
# VENUAI_API_TOKEN=                  # bearer used by MCP upload_document / query_with_rag
# MCP_PUBLIC_URL=
# MCP_AUTH_SERVER=
# A2A_ENABLED=off
# A2A_PUBLIC_URL=
# A2A_RATE_LIMIT_PER_MIN=20

# --- B2 ---
# KG_RETRIEVAL / RAPTOR / LOCAL_FAITHFULNESS are read by B1's pipeline and these modules; all default off.
KG_NER_LLM=off
RAPTOR=off
RAPTOR_MAX_CALLS=6
LOCAL_FAITHFULNESS=off
# LOCAL_FAITHFULNESS_MODEL=vectara/hallucination_evaluation_model
LOCAL_FAITHFULNESS_DOWNLOAD=off
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5   # opt-in; re-index with scripts/reindex.py first
# PROMPT_GUARD_FALLBACK_MODELS=meta-llama/llama-prompt-guard-2-22m
# SAFEGUARD_FALLBACK_MODELS=
# EVAL_JUDGE_API_KEY=                      # separate key for the eval judge
COLPALI_ENABLED=off

# --- B4 ---
# Voice (Groq whisper-large-v3-turbo STT, canopylabs/orpheus-v1-english TTS). Default off; audio never stored.
VOICE_ENABLED=off
# VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_TTS_MODEL=canopylabs/orpheus-v1-english
# VOICE_TTS_CHUNK_CHARS=200
# Long-term memory: global flag AND per-user opt-in (PUT /memory/settings). Default off.
LONG_TERM_MEMORY=off
# Deep research jobs
# RESEARCH_JOBS_DB=VENUAI/data/research_jobs.db
# RESEARCH_JOB_WORKERS=2

# --- B1 (pipeline core) ---
# SEMANTIC_CACHE=exact          # off | exact | semantic (semantic needs threshold >= 0.98, see Documents/AI/pipeline.md)
# SEMANTIC_CACHE_TTL_S=86400
# SEMANTIC_CACHE_THRESHOLD=0.98
# MODEL_CASCADE=on              # 20b for simple lookups, 120b for synthesis, escalate on low verifier confidence
# MAX_ESCALATIONS=1
# ESCALATE_GROUNDING_BELOW=0.1
# CASCADE_LLM_ROUTER=off
# CORRECTIVE_RAG=on             # capped self-reflective loop (depth != fast)
# CORRECTIVE_MAX_ITERS=2        # hard maximum 2
# CORRECTIVE_LLM_GRADER=on      # fast-model grader, borderline retrievals only
# FOLLOWUPS=on
# REQUEST_TOKEN_BUDGET=40000    # 0 = off
# TENANT_DAILY_TOKEN_BUDGET=2000000   # 0 = off; downshift at BUDGET_DOWNSHIFT_AT (0.8), refuse at 100%
# VERIFY_MAX_CLAIMS=6
# VERIFY_CHUNKS_PER_CLAIM=2
# WARMUP_MODELS=on              # load NLI + reranker in a startup thread
# KG_RETRIEVAL=off              # on = multi-hop queries only, force = always (needs stream B2 module)
# RAPTOR=off
# --- Security / deployment (S5; S1-S4 vars are consolidated here at merge time) ---
# development | production. production: demo user off, /docs off, strict config validation.
APP_ENV=development
# Dev convenience only (default true when APP_ENV!=production, always off in production).
# SEED_DEMO_USER=true
# Proxy trust: uvicorn --forwarded-allow-ips (Docker image reads these two)
# FORWARDED_ALLOW_IPS=127.0.0.1
# UVICORN_WORKERS=1
# Never enable code execution in production without a dedicated sandbox runner.
# ENABLE_CODE_EXECUTION=false
# Generate secrets with: python scripts/security/gen_secrets.py
# MCP_API_KEY=<GENERATE_WITH_GEN_SECRETS>

