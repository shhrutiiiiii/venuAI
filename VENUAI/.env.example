# Copy this file to .env and fill in real values. Never commit the real .env.

# Groq LLM API key — https://console.groq.com
GROQ_API_KEY=<GROQ_API_KEY>

# A real Groq-served model id (see Documents/architecture-decisions.md ADR-001)
GROQ_MODEL=openai/gpt-oss-120b

# Per-request timeout for every Groq call, seconds (default 30). The AIGateway owns retries.
GROQ_TIMEOUT_SECONDS=30

# JWT signing secret — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The server refuses to start without this set to a real value.
JWT_SECRET_KEY=<GENERATE_WITH_SECRETS_TOKEN_URLSAFE>

# Optional token lifetimes (seconds) — defaults shown
ACCESS_TOKEN_TTL_SECONDS=1800
REFRESH_TOKEN_TTL_SECONDS=1209600

# Comma-separated list of frontend origins allowed to call this API
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Phase 5 — all optional; each feature below is a real implementation
# that stays inactive (and fails loud, never silently fakes success) until
# its real credentials are set. See the referenced doc for exactly what
# each gates. ──────────────────────────────────────────────────────────────

# Structured JSON logging (VENUAI/observability.py) — "text" (default) or "json"
LOG_FORMAT=text
LOG_LEVEL=INFO

# Knowledge graph backend (Documents/AI/knowledge-graph.md) — "sqlite" (default, zero-config) or "postgres"
KNOWLEDGE_GRAPH_BACKEND=sqlite
# Only read when KNOWLEDGE_GRAPH_BACKEND=postgres. Either DATABASE_URL, or the PG* vars below.
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/venuai_graph
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=<SET_A_REAL_PASSWORD>
# PGDATABASE=venuai_graph

# OAuth sign-in (Documents/Backend/oauth.md) — unset = that provider's
# /auth/oauth/{provider}/login returns 503, not a fake success.
# GOOGLE_CLIENT_ID=<FROM_GOOGLE_CLOUD_CONSOLE>
# GOOGLE_CLIENT_SECRET=<FROM_GOOGLE_CLOUD_CONSOLE>
# GITHUB_CLIENT_ID=<FROM_GITHUB_DEVELOPER_SETTINGS>
# GITHUB_CLIENT_SECRET=<FROM_GITHUB_DEVELOPER_SETTINGS>

# Password-reset email delivery (Documents/Backend/password-reset.md) —
# unset = /auth/forgot-password returns 503 for a real account, not a fake "sent."
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=<YOUR_SMTP_USERNAME>
# SMTP_PASSWORD=<YOUR_SMTP_PASSWORD_OR_APP_PASSWORD>
# SMTP_FROM_EMAIL=noreply@yourdomain.com
# FRONTEND_URL=http://localhost:3000

# MCP server HTTP transport (Documents/AI/mcp-deployment.md) — required
# only when running mcp_server.py with MCP_TRANSPORT=http; the stdio
# transport (the default) needs none of this.
# MCP_TRANSPORT=stdio
# MCP_API_KEY=<GENERATE_WITH_SECRETS_TOKEN_URLSAFE>
# MCP_PORT=8765

# ── Retrieval quality (Documents/AI/retrieval.md) — all optional ───────────
# RERANKER_ENABLED=true
# RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# RETRIEVAL_CANDIDATES=4
# RETRIEVAL_MIN_SCORE=0.02
# RETRIEVAL_MIN_SIMILARITY=0.2
# QUERY_REWRITE_ENABLED=true
# QUERY_REWRITE_ALTERNATIVES=1
# CONTEXTUAL_CHUNKING=true
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2   # changing it requires re-indexing

# ── Trust & safety (A3) ───────────────────────────────────────────────────────
# Demo accounts demo@chat.com / admin@chat.com are seeded on first run. Set to false in PRODUCTION.
SEED_DEMO_USER=true
# Groq prompt-injection classifier on user input + ingested chunks (falls back to regex if unavailable)
PROMPT_GUARD_ENABLED=true
# gpt-oss-safeguard policy classifier on answers (fail-open => safety_check="unavailable", never faked)
SAFEGUARD_ENABLED=true
# INGEST_GUARD_MAX_CHUNKS=200

# --- B4 ---
# Voice (Groq whisper-large-v3-turbo STT, canopylabs/orpheus-v1-english TTS). Default off; audio never stored.
VOICE_ENABLED=off
# VOICE_STT_MODEL=whisper-large-v3-turbo
# VOICE_TTS_MODEL=canopylabs/orpheus-v1-english
# VOICE_TTS_CHUNK_CHARS=200
# Long-term memory: global flag AND per-user opt-in (PUT /memory/settings). Default off.
LONG_TERM_MEMORY=off
# Deep research jobs
# RESEARCH_JOBS_DB=VENUAI/data/research_jobs.db
# RESEARCH_JOB_WORKERS=2
