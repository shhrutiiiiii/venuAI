# Production compose variables (docker-compose.prod.yml). Copy to .env.prod (gitignored),
# fill in, and generate values with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SITE_ADDRESS=venuai.example.com
# Path to the backend env file (GROQ_API_KEY, JWT_SECRET_KEY, ...). Not in git.
BACKEND_ENV_FILE=VENUAI/.env
# Docker network CIDR or * (the backend is only reachable from the internal network)
FORWARDED_ALLOW_IPS=*
UVICORN_WORKERS=2
# Only with `--profile postgres`
POSTGRES_USER=venuai
POSTGRES_PASSWORD=<GENERATE: python -c "import secrets; print(secrets.token_urlsafe(48))">
